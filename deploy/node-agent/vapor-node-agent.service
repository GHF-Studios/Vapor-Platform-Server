[Unit]
Description=Vapor enrolled server telemetry reporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vapor-node-agent
Group=vapor-node-agent
ExecStart=/usr/local/bin/vapor-node-agent --config /etc/vapor/node-agent.toml
Restart=on-failure
RestartSec=15s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
