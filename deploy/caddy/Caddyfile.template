(vapor_routes) {
	encode zstd gzip

	redir /atlas /atlas/ permanent
	handle_path /atlas/* {
		root * /srv/vapor-web/atlas/current
		file_server
	}

	handle /api/build-cache/v1/internal/* {
		respond "not found" 404
	}

	handle {
		reverse_proxy 127.0.0.1:7110
	}
}

{{VAPOR_HTTP_FALLBACK_BLOCK}}

{{VAPOR_DOMAIN}} {
	import vapor_routes
}
