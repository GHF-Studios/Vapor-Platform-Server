# Example with a dedicated admin hostname; configure DNS and HTTPS before using it.
(vapor_routes) {
	encode zstd gzip

	redir /atlas /atlas/ permanent
	redir /docs /docs/ permanent
	# This callback is reachable only by Caddy's loopback forward-auth request.
	handle /api/admin/emergency-console/authorize {
		respond "not found" 404
	}
	handle /admin* {
		redir https://admin.example.test{http.request.uri} 308
	}

	handle /api/admin* {
		respond "not found" 404
	}

	handle /login* {
		redir https://admin.example.test{http.request.uri} 308
	}

	handle /logout {
		redir https://admin.example.test{http.request.uri} 308
	}

	handle /cli/ssh/* {
		redir https://admin.example.test{http.request.uri} 308
	}

	handle /api/identity/v1/admin* {
		respond "not found" 404
	}
	redir /emergency-terminal /emergency-terminal/ permanent
	handle /emergency-terminal/* {
		respond "not found" 404
	}

	handle_path /atlas/* {
		root * /srv/vapor-web/atlas/current
		file_server
	}

	handle_path /docs/* {
		reverse_proxy 127.0.0.1:7112
	}

	handle /api/identity/v1/internal/* {
		respond "not found" 404
	}

	handle_path /api/identity/* {
		reverse_proxy 127.0.0.1:7113
	}

	handle_path /api/diagnostics/* {
		reverse_proxy 127.0.0.1:7114
	}

	handle_path /api/registry/* {
		reverse_proxy 127.0.0.1:7115
	}

	handle /api/updates/* {
		reverse_proxy 127.0.0.1:7116
	}

	handle /api/build-cache/v1/internal/* {
		respond "not found" 404
	}

	handle_path /api/build-cache/* {
		reverse_proxy 127.0.0.1:7117
	}

	handle {
		reverse_proxy 127.0.0.1:7111
	}
}

(vapor_admin_routes) {
	encode zstd gzip

	handle /api/admin/emergency-console/authorize {
		respond "not found" 404
	}
	redir /emergency-terminal /emergency-terminal/ permanent
	# Root terminal is a separate service on a private Unix socket. Platform
	# checks Identity and the short grant on every resource/WS request.
	handle /emergency-terminal/* {
		log_skip
		header Cache-Control "private, no-store"
		forward_auth 127.0.0.1:7110 {
			uri /api/admin/emergency-console/authorize
			header_up X-Vapor-Console-Gateway CaddyEmergencyTerminalV1
			header_up X-Vapor-Console-Original-Method {http.request.method}
			header_up X-Vapor-Console-Original-Uri {http.request.uri}
			header_up X-Vapor-Console-Original-Origin {http.request.header.Origin}
			header_up X-Vapor-Console-Original-Upgrade {http.request.header.Upgrade}
			header_up X-Vapor-Console-Original-Fetch-Site {http.request.header.Sec-Fetch-Site}
			copy_headers X-Vapor-Console-User
		}
		reverse_proxy unix//run/vapor-emergency-console/ttyd.sock {
			header_up Host {http.request.host}
			header_up -Cookie
			header_up -Authorization
			transport http {
				versions 1.1
			}
			stream_timeout 20m
		}
	}

	handle /admin* {
		reverse_proxy 127.0.0.1:7110
	}

	handle /api/admin* {
		reverse_proxy 127.0.0.1:7110
	}

	handle /api/identity/v1/internal/* {
		respond "not found" 404
	}

	handle_path /api/identity/* {
		reverse_proxy 127.0.0.1:7113
	}

	handle /login* {
		reverse_proxy 127.0.0.1:7113
	}

	handle /logout {
		reverse_proxy 127.0.0.1:7113
	}

	handle /cli/ssh/* {
		reverse_proxy 127.0.0.1:7113
	}

	handle {
		redir /admin 302
	}
}

public.example.test {
	import vapor_routes
}

admin.example.test {
	import vapor_admin_routes
}
