(vapor_routes) {
	encode zstd gzip

	redir /atlas /atlas/ permanent
	redir /docs /docs/ permanent
	# This callback is reachable only by Caddy's loopback forward-auth request.
	handle /api/admin/emergency-console/authorize {
		respond "not found" 404
	}
	{{VAPOR_PUBLIC_ADMIN_ENTRY_BLOCK}}
	{{VAPOR_PUBLIC_TERMINAL_BLOCK}}

	handle_path /atlas/* {
		root * /srv/vapor-web/atlas/current
		file_server
	}

	handle_path /docs/* {
		reverse_proxy 127.0.0.1:7112
	}

	handle /api/identity/v1/internal/* {
		respond "not found" 404
	}

	handle_path /api/identity/* {
		reverse_proxy 127.0.0.1:7113
	}

	handle_path /api/diagnostics/* {
		reverse_proxy 127.0.0.1:7114
	}

	handle_path /api/registry/* {
		reverse_proxy 127.0.0.1:7115
	}

	handle /api/updates/* {
		reverse_proxy 127.0.0.1:7116
	}

	handle /api/build-cache/v1/internal/* {
		respond "not found" 404
	}

	handle_path /api/build-cache/* {
		reverse_proxy 127.0.0.1:7117
	}

	handle {
		reverse_proxy 127.0.0.1:7111
	}
}

(vapor_admin_routes) {
	encode zstd gzip

	handle /api/admin/emergency-console/authorize {
		respond "not found" 404
	}
	{{VAPOR_ADMIN_TERMINAL_ROUTE}}

	handle /admin* {
		reverse_proxy 127.0.0.1:7110
	}

	handle /api/admin* {
		reverse_proxy 127.0.0.1:7110
	}

	{{VAPOR_ADMIN_IDENTITY_ROUTES}}

	handle {
		redir /admin 302
	}
}

{{VAPOR_HTTP_FALLBACK_BLOCK}}

{{VAPOR_DOMAIN}} {
	import vapor_routes
}

{{VAPOR_ADMIN_DOMAIN_BLOCK}}
