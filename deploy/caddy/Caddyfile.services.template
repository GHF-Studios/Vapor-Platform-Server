(vapor_routes) {
	encode zstd gzip

	redir /atlas /atlas/ permanent

	# Keep the shared operator shell at the public origin. Platform serves its
	# own pages/assets and proxies only fixed service-owned admin sections.
	handle /admin* {
		reverse_proxy 127.0.0.1:7110
	}

	handle /api/admin* {
		reverse_proxy 127.0.0.1:7110
	}

	handle_path /atlas/* {
		root * /srv/vapor-web/atlas/current
		file_server
	}

	handle_path /docs/* {
		reverse_proxy 127.0.0.1:7112
	}

	handle_path /api/identity/* {
		reverse_proxy 127.0.0.1:7113
	}

	handle_path /api/diagnostics/* {
		reverse_proxy 127.0.0.1:7114
	}

	handle_path /api/registry/* {
		reverse_proxy 127.0.0.1:7115
	}

	handle /api/updates/* {
		reverse_proxy 127.0.0.1:7116
	}

	handle /api/build-cache/v1/internal/* {
		respond "not found" 404
	}

	handle_path /api/build-cache/* {
		reverse_proxy 127.0.0.1:7117
	}

	handle /login* {
		reverse_proxy 127.0.0.1:7113
	}

	handle /logout {
		reverse_proxy 127.0.0.1:7113
	}

	handle {
		reverse_proxy 127.0.0.1:7111
	}
}

{{VAPOR_HTTP_FALLBACK_BLOCK}}

{{VAPOR_DOMAIN}} {
	import vapor_routes
}
