[Unit]
Description=Vapor Build Cache Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vapor
Group=vapor
WorkingDirectory=/opt/vapor-platform-server
EnvironmentFile=/etc/vapor-server/build-cache.env
ExecStart=/opt/vapor-platform-server/target/release/vapor_build_cache_server
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vapor-server/build-cache

[Install]
WantedBy=multi-user.target
