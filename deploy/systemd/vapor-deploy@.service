[Unit]
Description=Execute approved Vapor Platform deployment request %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=infinity
EnvironmentFile=-/etc/vapor-server/platform.env
ExecStart=/usr/bin/flock /run/vapor-server-deploy.lock /opt/vapor-platform-server/deploy/scripts/run-approved-deploy.sh %i
